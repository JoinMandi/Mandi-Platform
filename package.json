{
  "name": "joinmandi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run src/server/data/rls.test.ts",
    "db:provision": "node --env-file-if-exists=.env.local db/provision.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m db/migrations",
    "db:rollback": "node --env-file-if-exists=.env.local ./node_modules/node-pg-migrate/bin/node-pg-migrate.js down -m db/migrations",
    "db:seed": "node --env-file-if-exists=.env.local db/seed.mjs",
    "db:setup": "npm run db:provision && npm run db:migrate && npm run db:seed",
    "docs:diagrams": "node scripts/render-diagrams.mjs",
    "translations:export": "node scripts/export-translations-csv.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1176.0",
    "@aws-sdk/client-s3": "^3.1176.0",
    "framer-motion": "^12.38.0",
    "i18next": "^23.11.3",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-http-backend": "^2.5.2",
    "iron-session": "^9.1.1",
    "jose": "^6.2.18",
    "next": "14.2",
    "next-i18next": "^15.3.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "react": "^18",
    "react-dom": "^18",
    "react-i18next": "^14.1.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
