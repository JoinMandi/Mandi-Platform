# Runtime configuration. Copy to .env.local for local development.
# Never commit real values.

# ── Database ─────────────────────────────────────────────────
# Owner role: migrations only.
DATABASE_URL=postgres://mandi_admin:localdev@localhost:5433/mandi
# App role: normal request traffic, subject to RLS.
DATABASE_APP_URL=postgres://mandi_app:localdev@localhost:5433/mandi
# Service role: privileged operations (delete-user, audit writes). Bypasses RLS.
DATABASE_SERVICE_URL=postgres://mandi_service:localdev@localhost:5433/mandi

# ── Session ──────────────────────────────────────────────────
# At least 32 characters. Generate with: openssl rand -base64 32
SESSION_SECRET=

# ── Cognito ──────────────────────────────────────────────────
COGNITO_REGION=af-south-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
# Hosted UI domain, e.g. mandi-staging.auth.af-south-1.amazoncognito.com
COGNITO_DOMAIN=

# ── App ──────────────────────────────────────────────────────
APP_URL=http://localhost:3000
# Public hostname Caddy serves in staging (A record at GoDaddy → Elastic IP).
APP_DOMAIN=
# Optional WhatsApp handoff for booking requests (digits, country code first).
NEXT_PUBLIC_WHATSAPP_NUMBER=
AWS_REGION=af-south-1
S3_BUCKET=

# ── Email (Resend; SES migration is Phase 1+) ────────────────
RESEND_API_KEY=
RESEND_FROM=

# ── Test database (RLS tests) ────────────────────────────────
TEST_DATABASE_URL=postgres://mandi_admin:localdev@localhost:5433/mandi_test
